MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=info@example.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
TEST_EMAILS="dev@example.com"
BCC_EMAIL="bcc@example.com"
SEND_LIFE_EMAIL=false


PULK_PUBLISH_URL=https://example.com/wp-json/wp-gap/v1/receive-callback
PULK_PUBLISH_TOKEN=your_pulk_token_here

SANCTUM_EXPIRATION_SESSION_TIME=480

BEWOTEC_DAVINCI_GENVAS_URL=http://services.example.com/GenVasWebService
BEWOTEC_DAVINCI_PPS_URL=http://services.example.com
BEWOTEC_DAVINCI_SSC_URL=http://services.example.com
BEWOTEC_DAVINCI_USER=your_davinci_user
BEWOTEC_DAVINCI_PASSWORD=your_davinci_password
BEWOTEC_DAVINCI_CATALOG_CODE=2223
BEWOTEC_DAVINCI_AGENCY_NUMBER_DEFAULT=1
BEWOTEC_DAVINCI_TOUROPERATOR_CODE_DEFAULT=GG
BEWOTEC_JOBS_LIMITER=10000
BEWOTEC_DAVINCI_SCHEDULED_TASKS=false
BEWOTEC_DAVINCI_CLEAN_UP_SUB_HOURS=168
BEWOTEC_DAVINCI_BACKOFF_JOB="60,600,3600"